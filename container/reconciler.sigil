module container.reconciler
  targets server
  trust none

use container.error.ContainerError;
use container.limits.max_reconcile_interval_ms;
use container.limits.max_replicas;
use container.limits.max_restart_backoff_ms;
use container.limits.max_workload_count;
use container.limits.min_reconcile_interval_ms;
use container.reconcile_state.OperationRecord;
use container.reconcile_state.PolicyRecord;
use container.reconcile_state.RestartStateRecord;
use container.reconcile_state.new_restart_state_record;
use container.reconcile_state.validate_policy;

// ADR 0053 決定 2 (P5-3): 単一ノードの調整ループの純粋な核。
// 望ましい状態 (宣言) と、実行環境から取り直した観測を入力に、収束のための計画を返す。
// 計画の各操作は「その状態にする」形で冪等であり、操作 ID は (インスタンス, 種別, 世代) から決定的に決まる。
// 実行環境への作用 (ランタイムの起動・停止など) と状態の書き込みは呼び出し側が行う。

// 配置の単位: ワークロード (望ましい状態の宣言)。ノードは初版では一つだが node_id を持たせて拡張できるようにする。
pub struct Declaration {
  workload_id: String,
  node_id: String,
  replicas: Int,
  version: Int,
  policy: PolicyRecord,
}

// 実行環境から取り直した観測 (保存した状態は鵜呑みにしない)。
// runtime_status: "created" / "running" / "stopped"。実行環境に無いインスタンスは一覧に含まれない。
pub struct Observed {
  instance_id: String,
  workload_id: String,
  runtime_status: String,
  exit_code: Int,
  health_failures: Int,  // 連続したヘルスチェック失敗数 (判定不能も失敗に数える)
  uptime_ms: Int,
}

// 計画された操作。kind: "create" / "start" / "stop" / "delete"
pub struct PlannedAction {
  op_id: String,
  instance_id: String,
  workload_id: String,
  kind: String,
}

pub struct TickPlan {
  actions: List<PlannedAction>,
  restart_updates: List<RestartStateRecord>,
  satisfied_ops: List<String>,  // 観測により既に満たされた Pending 操作の ID (Done にしてよい)
  gave_up: List<String>,  // 再起動の上限に達して止めたインスタンス
  unhealthy: List<String>,  // 不健全と判定したインスタンス
}

pub enum ProbeResult {
  Healthy,
  Unhealthy,
  Unknown,
}

pub fn empty_tick_plan() -> TickPlan
  intent "空の計画を返す"
  requires none
  ensures none
  effects none
{
  return TickPlan { actions: List.new(), restart_updates: List.new(), satisfied_ops: List.new(), gave_up: List.new(), unhealthy: List.new() };
}

pub fn new_declaration(workload_id: String, node_id: String, replicas: Int, version: Int, policy: PolicyRecord) -> Declaration
  intent "Declaration を構築する"
  requires none
  ensures none
  effects none
{
  return Declaration { workload_id: workload_id, node_id: node_id, replicas: replicas, version: version, policy: policy };
}

pub fn new_observed(instance_id: String, workload_id: String, runtime_status: String, exit_code: Int, health_failures: Int, uptime_ms: Int) -> Observed
  intent "Observed を構築する"
  requires none
  ensures none
  effects none
{
  return Observed { instance_id: instance_id, workload_id: workload_id, runtime_status: runtime_status, exit_code: exit_code, health_failures: health_failures, uptime_ms: uptime_ms };
}

pub fn int_to_str(val: Int) -> String
  intent "非負の整数を 10 進文字列に変換する"
  requires none
  ensures none
  effects none
{
  if val <= 0 {
    return "0";
  }
  let mut n = val;
  let mut digits = List.new();
  while n > 0 {
    digits.push(n % 10);
    n = n / 10;
  }
  let mut buf = Bytes.new();
  let mut i = digits.len();
  while i > 0 {
    i = i - 1;
    match digits.get(i) {
      Some(d) => {
        buf.push(48 + d);
      }
      None => {}
    }
  }
  return match buf.to_string_utf8() {
    Ok(s) => s,
    Err(_) => "",
  };
}

pub fn instance_id_for(workload_id: &String, index: Int) -> String
  intent "ワークロード ID と添字からインスタンス ID を決定的に作る (再実行で二重に作らないため)"
  requires none
  ensures none
  effects none
{
  let mut buf = Bytes.new();
  buf.extend(&workload_id.as_bytes());
  buf.push(45);
  buf.extend(&int_to_str(index).as_bytes());
  return match buf.to_string_utf8() {
    Ok(s) => s,
    Err(_) => "",
  };
}

pub fn make_op_id(instance_id: &String, kind: &String, epoch: Int) -> String
  intent "操作 ID (インスタンス:種別:世代) を決定的に作る"
  requires none
  ensures none
  effects none
{
  let mut buf = Bytes.new();
  buf.extend(&instance_id.as_bytes());
  buf.push(58);
  buf.extend(&kind.as_bytes());
  buf.push(58);
  buf.extend(&int_to_str(epoch).as_bytes());
  return match buf.to_string_utf8() {
    Ok(s) => s,
    Err(_) => "",
  };
}

// ---------------------------------------------------------------------------
// ヘルスチェックの判定 (失敗を黙って成功にしない)
// ---------------------------------------------------------------------------

pub fn next_health_failures(prev: Int, probe: &ProbeResult) -> Int
  intent "プローブの結果から連続失敗数を更新する。判定不能 (Unknown) は成功にせず失敗として数える"
  requires none
  ensures none
  effects none
{
  return match probe {
    ProbeResult.Healthy => 0,
    ProbeResult.Unhealthy => prev + 1,
    ProbeResult.Unknown => prev + 1,
  };
}

pub fn evaluate_health(p: &PolicyRecord, o: &Observed) -> String
  intent "宣言とプローブの連続失敗数から 'disabled' / 'starting' / 'healthy' / 'unhealthy' を判定する"
  requires none
  ensures none
  effects none
{
  if !p.health.enabled {
    return "disabled";
  }
  if o.uptime_ms < p.health.start_period_ms {
    return "starting";
  }
  if o.health_failures >= p.health.failure_threshold {
    return "unhealthy";
  }
  return "healthy";
}

// ---------------------------------------------------------------------------
// 再起動の方針
// ---------------------------------------------------------------------------

pub fn backoff_delay_ms(base_ms: Int, restart_count: Int) -> Int
  intent "再起動の待ち時間 (基準 × 2^回数、上限あり) を返す。無制限に伸びない"
  requires none
  ensures none
  effects none
{
  let mut delay = base_ms;
  let mut i = 0;
  while i < restart_count {
    delay = delay * 2;
    if delay >= max_restart_backoff_ms() {
      return max_restart_backoff_ms();
    }
    i = i + 1;
  }
  if delay > max_restart_backoff_ms() {
    return max_restart_backoff_ms();
  }
  return delay;
}

pub fn clamp_reconcile_interval(requested_ms: Int) -> Int
  intent "周期的な再調整の間隔を許容範囲 (1 秒〜1 時間) に収める。無制限に短くできない"
  requires none
  ensures none
  effects none
{
  if requested_ms < min_reconcile_interval_ms() {
    return min_reconcile_interval_ms();
  }
  if requested_ms > max_reconcile_interval_ms() {
    return max_reconcile_interval_ms();
  }
  return requested_ms;
}

// ---------------------------------------------------------------------------
// いつ調整するか (通知 + 周期)
// ---------------------------------------------------------------------------

// 通知を取りこぼしても、通知の購読が切れても、周期的な再調整で必ず収束できるようにする。
pub fn should_reconcile(now_ms: Int, last_reconcile_ms: Int, interval_ms: Int, notified: Bool) -> Bool
  intent "通知を受けた、または前回から再調整の間隔が経過した場合に調整する。通知の有無に依らず周期で動く"
  requires none
  ensures none
  effects none
{
  if notified {
    return true;
  }
  if last_reconcile_ms < 0 {
    return true;
  }
  return now_ms - last_reconcile_ms >= clamp_reconcile_interval(interval_ms);
}

// ---------------------------------------------------------------------------
// 探索の補助
// ---------------------------------------------------------------------------

fn list_contains(list: &List<String>, s: &String) -> Bool
  intent "文字列の一覧に s が含まれるか"
  requires none
  ensures none
  effects none
{
  let mut i = 0;
  while i < list.len() {
    match list.get(i) {
      Some(v) => {
        if v == s {
          return true;
        }
      }
      None => {}
    }
    i = i + 1;
  }
  return false;
}

fn find_observed(observed: &List<Observed>, id: &String) -> Int
  intent "観測の一覧から ID が一致する添字を返す。無ければ -1"
  requires none
  ensures none
  effects none
{
  let mut i = 0;
  while i < observed.len() {
    match observed.get(i) {
      Some(o) => {
        if o.instance_id == id {
          return i;
        }
      }
      None => {}
    }
    i = i + 1;
  }
  return -1;
}

fn op_rank(kind: &String) -> Int
  intent "再開時の操作の順序 (停止 0 → 削除 1 → 作成 2 → 起動 3)"
  requires none
  ensures none
  effects none
{
  if kind == "stop" {
    return 0;
  }
  if kind == "delete" {
    return 1;
  }
  if kind == "create" {
    return 2;
  }
  return 3;
}

fn workload_of(observed: &List<Observed>, id: &String) -> String
  intent "観測からインスタンスのワークロード ID を引く。観測に無ければ ID の末尾の '-添字' を除いたものを返す"
  requires none
  ensures none
  effects none
{
  let oi = find_observed(&observed, &id);
  if oi >= 0 {
    let mut out = "";
    match observed.get(oi) {
      Some(o) => {
        out = o.workload_id.clone();
      }
      None => {}
    }
    return out;
  }
  let bytes = id.as_bytes();
  let mut end = bytes.len();
  while end > 0 && bytes.get(end - 1).unwrap_or(0) != 45 {
    end = end - 1;
  }
  if end <= 1 {
    return id.clone();
  }
  let mut buf = Bytes.new();
  let mut i = 0;
  while i < end - 1 {
    buf.push(bytes.get(i).unwrap_or(0));
    i = i + 1;
  }
  return match buf.to_string_utf8() {
    Ok(s) => s,
    Err(_) => "",
  };
}

fn find_restart_state(states: &List<RestartStateRecord>, id: &String) -> Int
  intent "再起動の経過の一覧から ID が一致する添字を返す。無ければ -1"
  requires none
  ensures none
  effects none
{
  let mut i = 0;
  while i < states.len() {
    match states.get(i) {
      Some(s) => {
        if s.instance_id == id {
          return i;
        }
      }
      None => {}
    }
    i = i + 1;
  }
  return -1;
}

fn has_pending_for(pending: &List<OperationRecord>, id: &String) -> Bool
  intent "インスタンスに未完了 (Pending/Failed) の操作があるか"
  requires none
  ensures none
  effects none
{
  let mut i = 0;
  while i < pending.len() {
    match pending.get(i) {
      Some(p) => {
        if p.instance_id == id && p.status != "Done" {
          return true;
        }
      }
      None => {}
    }
    i = i + 1;
  }
  return false;
}

fn push_action(plan: &mut TickPlan, instance_id: &String, workload_id: &String, kind: &String, epoch: Int)
  intent "計画に操作を追加する"
  requires none
  ensures none
  effects none
{
  plan.actions.push(PlannedAction { op_id: make_op_id(&instance_id, &kind, epoch), instance_id: instance_id.clone(), workload_id: workload_id.clone(), kind: kind.clone() });
}

fn is_satisfied(kind: &String, found: Bool, status: &String) -> Bool
  intent "操作の目的が観測で既に満たされているか。操作は常に 'その状態にする' 形で冪等"
  requires none
  ensures none
  effects none
{
  if kind == "create" {
    return found;
  }
  if kind == "start" {
    return found && status == "running";
  }
  if kind == "stop" {
    return !found || status != "running";
  }
  return !found;
}

// ---------------------------------------------------------------------------
// 計画
// ---------------------------------------------------------------------------

pub fn plan_tick(decls: &List<Declaration>, observed: &List<Observed>, restart_states: &List<RestartStateRecord>, pending: &List<OperationRecord>, now_ms: Int) -> Result<TickPlan, ContainerError>
  intent "宣言と観測の差を埋める計画を作る。宣言の上限を先に検査し、超過は黙って切り捨てず失敗する。冪等で、再実行しても二重適用にならない"
  requires none
  ensures none
  effects none
{
  if decls.len() > max_workload_count() {
    return Err(ContainerError.LimitExceeded("ワークロード数が上限 (1,024) を超えています。"));
  }

  let mut plan = TickPlan { actions: List.new(), restart_updates: List.new(), satisfied_ops: List.new(), gave_up: List.new(), unhealthy: List.new() };
  let mut handled = List.new();

  // 1. 未完了の操作を先に再開する (強制終了からの再開)。観測で満たされていれば Done にしてよい。
  //    保存順に依らず、停止→削除→作成→起動の順で再開する (起動は作成の後でなければ意味がない)。
  let mut rank = 0;
  while rank < 4 {
    let mut pi = 0;
    while pi < pending.len() {
      match pending.get(pi) {
        Some(p) => {
          if p.status != "Done" && op_rank(&p.kind) == rank {
            let oi = find_observed(&observed, &p.instance_id);
            let mut found = false;
            let mut status = "";
            if oi >= 0 {
              match observed.get(oi) {
                Some(o) => {
                  found = true;
                  status = o.runtime_status.clone();
                }
                None => {}
              }
            }
            if is_satisfied(&p.kind, found, &status) {
              plan.satisfied_ops.push(p.op_id.clone());
            } else {
              plan.actions.push(PlannedAction { op_id: p.op_id.clone(), instance_id: p.instance_id.clone(), workload_id: workload_of(&observed, &p.instance_id), kind: p.kind.clone() });
            }
            handled.push(p.instance_id.clone());
          }
        }
        None => {}
      }
      pi = pi + 1;
    }
    rank = rank + 1;
  }

  // 2. 宣言ごとに差を埋める。
  let mut desired_ids = List.new();
  let mut di = 0;
  while di < decls.len() {
    match decls.get(di) {
      Some(d) => {
        match validate_policy(&d.policy) {
          Ok(_) => {}
          Err(e) => {
            return Err(e);
          }
        }
        if d.replicas < 0 || d.replicas > max_replicas() {
          return Err(ContainerError.LimitExceeded("レプリカ数が許容範囲 (0〜64) の外です。"));
        }
        let mut idx = 0;
        while idx < d.replicas {
          let id = instance_id_for(&d.workload_id, idx);
          desired_ids.push(id.clone());
          let is_handled = list_contains(&handled, &id);
          if !is_handled {
            plan_instance(&mut plan, &d, &id, &observed, &restart_states, now_ms);
          }
          idx = idx + 1;
        }
      }
      None => {}
    }
    di = di + 1;
  }

  // 3. 宣言に無いインスタンス (ワークロードの削除・レプリカの縮小) を止めて削除する。
  let mut oi = 0;
  while oi < observed.len() {
    match observed.get(oi) {
      Some(o) => {
        let wanted = list_contains(&desired_ids, &o.instance_id);
        if !wanted && !has_pending_for(&pending, &o.instance_id) {
          if o.runtime_status == "running" {
            push_action(&mut plan, &o.instance_id, &o.workload_id, &"stop", 0);
          }
          push_action(&mut plan, &o.instance_id, &o.workload_id, &"delete", 0);
        }
      }
      None => {}
    }
    oi = oi + 1;
  }

  return Ok(plan);
}

fn plan_instance(plan: &mut TickPlan, d: &Declaration, id: &String, observed: &List<Observed>, restart_states: &List<RestartStateRecord>, now_ms: Int)
  intent "1 つのインスタンスの差を埋める計画を作る (作成・起動・不健全または終了時の再起動の方針)"
  requires none
  ensures none
  effects none
{
  // 再起動の経過 (観測した状態の参考情報)
  let si = find_restart_state(&restart_states, &id);
  let mut count = 0;
  let mut phase = "Running";
  let mut next_at = 0;
  if si >= 0 {
    match restart_states.get(si) {
      Some(s) => {
        count = s.restart_count + 0;
        phase = s.phase.clone();
        next_at = s.next_restart_at_ms + 0;
      }
      None => {}
    }
  }

  let oi = find_observed(&observed, &id);
  if oi < 0 {
    // 実行環境に無い: 作成して起動する (世代 = 再起動回数)
    if phase == "GaveUp" {
      return;
    }
    push_action(&mut plan, &id, &d.workload_id, &"create", count);
    push_action(&mut plan, &id, &d.workload_id, &"start", count);
    return;
  }

  let mut status = "";
  let mut exit_code = 0;
  let mut health = "disabled";
  match observed.get(oi) {
    Some(o) => {
      status = o.runtime_status.clone();
      exit_code = o.exit_code + 0;
      health = evaluate_health(&d.policy, &o);
    }
    None => {
      return;
    }
  }

  if status == "created" {
    push_action(&mut plan, &id, &d.workload_id, &"start", count);
    return;
  }

  if status == "running" {
    if health == "unhealthy" {
      plan.unhealthy.push(id.clone());
      if d.policy.restart_kind != "no" && phase != "GaveUp" {
        // 不健全は失敗として扱い、止めてから再起動の方針に従う
        push_action(&mut plan, &id, &d.workload_id, &"stop", count);
        schedule_restart(&mut plan, &d, &id, count, now_ms, 0 - 1, &"ヘルスチェックの連続失敗");
      }
      return;
    }
    if phase != "Running" {
      plan.restart_updates.push(new_restart_state_record(id.clone(), count, next_at, 0, "Running", ""));
    }
    return;
  }

  // 停止している
  let policy_wants_restart = d.policy.restart_kind == "always" || (d.policy.restart_kind == "on_failure" && exit_code != 0);
  if !policy_wants_restart {
    return;
  }
  if phase == "GaveUp" {
    plan.gave_up.push(id.clone());
    return;
  }
  if phase == "Backoff" {
    if now_ms >= next_at {
      // 待ち時間が過ぎた: 削除→作成→起動 (世代を進める)
      push_action(&mut plan, &id, &d.workload_id, &"delete", count);
      push_action(&mut plan, &id, &d.workload_id, &"create", count + 1);
      push_action(&mut plan, &id, &d.workload_id, &"start", count + 1);
      plan.restart_updates.push(new_restart_state_record(id.clone(), count + 1, 0, exit_code, "Running", ""));
    }
    return;
  }
  schedule_restart(&mut plan, &d, &id, count, now_ms, exit_code, &"コンテナが終了した");
}

fn schedule_restart(plan: &mut TickPlan, d: &Declaration, id: &String, count: Int, now_ms: Int, exit_code: Int, reason: &String)
  intent "失敗したインスタンスの再起動を待ち時間付きで予約する。回数の上限に達したら止めて報告する"
  requires none
  ensures none
  effects none
{
  if count >= d.policy.max_retries {
    plan.restart_updates.push(new_restart_state_record(id.clone(), count, 0, exit_code, "GaveUp", reason.clone()));
    plan.gave_up.push(id.clone());
    return;
  }
  let delay = backoff_delay_ms(d.policy.backoff_ms, count);
  plan.restart_updates.push(new_restart_state_record(id.clone(), count, now_ms + delay, exit_code, "Backoff", reason.clone()));
}
