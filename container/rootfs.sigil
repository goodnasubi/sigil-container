module container.rootfs
  targets server
  trust none

use container.error.ContainerError;
use container.image_layout.inspect_tar_header;
use container.image_layout.parse_octal;
use container.image_layout.validate_path;
use container.limits.default_non_root_gid;
use container.limits.default_non_root_uid;
use container.limits.max_file_count;
use container.limits.max_total_image_size;
use container.state.RootfsRecord;
use container.state.new_rootfs_record;

// ADR 0053 決定 1・3・6 / ADR 0035: rootfs の展開と検証
// P5-1 の OCI Image Layout 読み取りと層パスの検査を使い、
// ADR 0035 のイメージ（単一層、静的 ELF /app、User 65532:65532、Entrypoint ["/app"]、WorkingDir /）
// の rootfs を展開・検証する。展開先は P5-1 の状態保存形式（RootfsRecord）で管理する。

pub struct RootfsEntry {
  path: String,
  size: Int,
  mode: Int,
  uid: Int,
  gid: Int,
  is_dir: Bool,
  payload: Bytes,
}

pub struct RootfsManifest {
  destination_path: String,
  entries: List<RootfsEntry>,
  total_bytes: Int,
  file_count: Int,
}

pub fn new_rootfs_entry(path: String, size: Int, mode: Int, uid: Int, gid: Int, is_dir: Bool, payload: Bytes) -> RootfsEntry
  intent "RootfsEntry を構築する"
  requires none
  ensures none
  effects none
{
  return RootfsEntry { path: path, size: size, mode: mode, uid: uid, gid: gid, is_dir: is_dir, payload: payload };
}

pub fn new_rootfs_manifest(destination_path: String, entries: List<RootfsEntry>, total_bytes: Int, file_count: Int) -> RootfsManifest
  intent "RootfsManifest を構築する"
  requires none
  ensures none
  effects none
{
  return RootfsManifest { destination_path: destination_path, entries: entries, total_bytes: total_bytes, file_count: file_count };
}

fn read_u16(bytes: &Bytes, offset: Int, is_le: Bool) -> Int
  intent "バイト列から 16 ビット整数を読み出す"
  requires none
  ensures none
  effects none
{
  let b0 = bytes.get(offset).unwrap_or(0);
  let b1 = bytes.get(offset + 1).unwrap_or(0);
  if is_le {
    return b0 + b1 * 256;
  } else {
    return b0 * 256 + b1;
  }
}

fn read_u32(bytes: &Bytes, offset: Int, is_le: Bool) -> Int
  intent "バイト列から 32 ビット整数を読み出す"
  requires none
  ensures none
  effects none
{
  let b0 = bytes.get(offset).unwrap_or(0);
  let b1 = bytes.get(offset + 1).unwrap_or(0);
  let b2 = bytes.get(offset + 2).unwrap_or(0);
  let b3 = bytes.get(offset + 3).unwrap_or(0);
  if is_le {
    return b0 + b1 * 256 + b2 * 65536 + b3 * 16777216;
  } else {
    return b0 * 16777216 + b1 * 65536 + b2 * 256 + b3;
  }
}

fn validate_elf_payload(payload: &Bytes) -> Result<Bool, ContainerError>
  intent "ELF ペイロードを検査し、静的実行可能バイナリ (ET_EXEC) であるかを検証する"
  requires none
  ensures none
  effects none
{
  // 1. payload 長 64 バイト以上
  if payload.len() < 64 {
    return Err(ContainerError.LayerValidation("/app のサイズが 64 バイト未満です (有効な ELF ヘッダではありません)。"));
  }

  // 2. ELF magic (0x7f, 'E', 'L', 'F')
  let m0 = payload.get(0).unwrap_or(0);
  let m1 = payload.get(1).unwrap_or(0);
  let m2 = payload.get(2).unwrap_or(0);
  let m3 = payload.get(3).unwrap_or(0);
  if m0 != 127 || m1 != 69 || m2 != 76 || m3 != 70 {
    return Err(ContainerError.LayerValidation("/app の ELF マジックヘッダが無効です。"));
  }

  // 3. EI_CLASS が 1 または 2
  let ei_class = payload.get(4).unwrap_or(0);
  if ei_class != 1 && ei_class != 2 {
    return Err(ContainerError.LayerValidation("/app の ELF クラスが無効です (32-bit または 64-bit 必須)。"));
  }

  // エンディアン (EI_DATA): 1 (LSB) または 2 (MSB)
  let ei_data = payload.get(5).unwrap_or(0);
  if ei_data != 1 && ei_data != 2 {
    return Err(ContainerError.LayerValidation("/app の ELF エンディアンが無効です。"));
  }
  let is_le = ei_data == 1;

  // 4. e_type == 2 (ET_EXEC) のみ許可し ET_DYN (3) は拒否
  let e_type = read_u16(&payload, 16, is_le);
  if e_type != 2 {
    return Err(ContainerError.LayerValidation("/app が静的実行ファイル (ET_EXEC) ではありません。ET_DYN や再配置可能ファイルは拒否されます。"));
  }

  // 5. ELF64（e_phoff 32、e_phentsize 54、e_phnum 56）と ELF32（e_phoff 28、e_phentsize 42、e_phnum 44）
  let mut phoff = 0;
  let mut phentsize = 0;
  let mut phnum = 0;

  if ei_class == 2 {
    let mut hi_offset = 32;
    let mut lo_offset = 36;
    if is_le {
      hi_offset = 36;
      lo_offset = 32;
    }
    let hi = read_u32(&payload, hi_offset, is_le);
    if hi != 0 {
      return Err(ContainerError.LayerValidation("/app のプログラムヘッダオフセットが有効範囲を超過しています。"));
    }
    phoff = read_u32(&payload, lo_offset, is_le);
    phentsize = read_u16(&payload, 54, is_le);
    phnum = read_u16(&payload, 56, is_le);
    if phentsize < 56 {
      return Err(ContainerError.LayerValidation("/app のプログラムヘッダエントリサイズが ELF64 規定未満です。"));
    }
  } else {
    phoff = read_u32(&payload, 28, is_le);
    phentsize = read_u16(&payload, 42, is_le);
    phnum = read_u16(&payload, 44, is_le);
    if phentsize < 32 {
      return Err(ContainerError.LayerValidation("/app のプログラムヘッダエントリサイズが ELF32 規定未満です。"));
    }
  }

  if phoff < 0 || phentsize < 0 || phnum < 0 {
    return Err(ContainerError.LayerValidation("/app のプログラムヘッダパラメータが無効です。"));
  }

  // プログラムヘッダの範囲が payload を超える場合は拒否
  let ph_table_end = phoff + phnum * phentsize;
  if ph_table_end > payload.len() {
    return Err(ContainerError.LayerValidation("/app のプログラムヘッダ範囲がペイロード末尾を超過しています。"));
  }

  // プログラムヘッダを走査して PT_DYNAMIC (2) / PT_INTERP (3) があれば拒否
  let mut i = 0;
  while i < phnum {
    let ph_entry_offset = phoff + i * phentsize;
    let p_type = read_u32(&payload, ph_entry_offset, is_le);
    if p_type == 2 {
      return Err(ContainerError.LayerValidation("/app に PT_DYNAMIC が含まれています (静的バイナリではありません)。"));
    }
    if p_type == 3 {
      return Err(ContainerError.LayerValidation("/app に PT_INTERP が含まれています (動的リンクバイナリは拒否されます)。"));
    }
    i = i + 1;
  }

  return Ok(true);
}

fn is_null_block(bytes: &Bytes, offset: Int) -> Bool
  intent "512 バイトブロックがすべてゼロ (null ブロック) かどうかを判定する"
  requires none
  ensures none
  effects none
{
  let mut i = 0;
  while i < 512 {
    let b = bytes.get(offset + i).unwrap_or(0);
    if b != 0 {
      return false;
    }
    i = i + 1;
  }
  return true;
}

pub fn unpack_layer_archive(tar_bytes: &Bytes, destination_path: &String) -> Result<RootfsManifest, ContainerError>
  intent "非圧縮 tar バイト列から rootfs エントリ群を安全に展開・検証し、RootfsManifest を生成する"
  requires none
  ensures none
  effects none
{
  if destination_path.len() == 0 {
    return Err(ContainerError.LayerValidation("展開先パス (destination_path) が空です。"));
  }

  let total_len = tar_bytes.len();
  if total_len % 512 != 0 {
    return Err(ContainerError.Corrupt("Tar アーカイブのサイズが 512 バイト境界に揃っていません。"));
  }

  let mut offset = 0;
  let mut entries = List.new();
  let mut total_bytes = 0;
  let mut file_count = 0;
  let mut consecutive_null_blocks = 0;
  let mut done = false;

  while offset < total_len && !done {
    if is_null_block(&tar_bytes, offset) {
      consecutive_null_blocks = consecutive_null_blocks + 1;
      offset = offset + 512;
      if consecutive_null_blocks >= 2 {
        // 終端 (2 つの 512 バイトゼロブロック) に到達
        done = true;
      }
    } else {
      if consecutive_null_blocks > 0 {
        return Err(ContainerError.Corrupt("終端ゼロブロックの後にデータブロックが存在します。"));
      }

      let header = tar_bytes.slice(offset, offset + 512).unwrap_or(Bytes.new());
      match inspect_tar_header(&header) {
        Ok(tar_entry) => {
          // エントリパスが destination 配下に収まること (../ や絶対パスを拒否)
          match validate_path(&tar_entry.path) {
            Ok(_) => {}
            Err(err) => {
              return Err(err);
            }
          }
          let p_bytes = tar_entry.path.as_bytes();
          if p_bytes.len() == 0 || p_bytes.get(0).unwrap_or(0) == 47 {
            return Err(ContainerError.LayerValidation("エントリパスが不正または絶対パスです。"));
          }

          // mode (100..108), uid (108..116), gid (116..124) のパース
          let mode = parse_octal(&header, 100, 8).unwrap_or(0);
          let uid = parse_octal(&header, 108, 8).unwrap_or(0);
          let gid = parse_octal(&header, 116, 8).unwrap_or(0);

          // 上限検査
          file_count = file_count + 1;
          if file_count > max_file_count() {
            return Err(ContainerError.LimitExceeded("展開エントリ数が上限 (100,000) を超過しました。"));
          }

          total_bytes = total_bytes + tar_entry.size;
          if total_bytes > max_total_image_size() {
            return Err(ContainerError.LimitExceeded("展開後合計サイズが上限 (4 GiB) を超過しました。"));
          }

          let is_dir = tar_entry.typeflag == 53;  // '5'

          // ADR 0035 では通常ファイル ('0' = 48 または NUL = 0) とディレクトリ ('5' = 53) のみを許可。
          // シンボリックリンクやハードリンクは ADR 0035 の仕様外として拒否
          if tar_entry.typeflag != 0 && tar_entry.typeflag != 48 && tar_entry.typeflag != 53 {
            return Err(ContainerError.LayerValidation("ADR 0035 仕様外のリンクまたは特殊ファイルエントリです。"));
          }

          // 境界検査: offset+512+size がアーカイブ末尾を超えたら Corrupt で拒否、ペイロード切り上げパディングも境界内に収まること。
          let payload_end = offset + 512 + tar_entry.size;
          if payload_end > total_len {
            return Err(ContainerError.Corrupt("Tar エントリのペイロードがアーカイブ末尾を超過しています。"));
          }

          let payload_blocks = (tar_entry.size + 511) / 512 * 512;
          let next_offset = offset + 512 + payload_blocks;
          if next_offset > total_len {
            return Err(ContainerError.Corrupt("Tar エントリのペイロードパディングがアーカイブ末尾を超過しています。"));
          }

          let payload = tar_bytes.slice(offset + 512, payload_end).unwrap_or(Bytes.new());

          let rootfs_entry = RootfsEntry { path: tar_entry.path, size: tar_entry.size, mode: mode, uid: uid, gid: gid, is_dir: is_dir, payload: payload };
          entries.push(rootfs_entry);

          offset = next_offset;
        }
        Err(err) => {
          return Err(err);
        }
      }
    }
  }

  return Ok(RootfsManifest { destination_path: destination_path.clone(), entries: entries, total_bytes: total_bytes, file_count: file_count });
}

pub fn validate_adr0035_rootfs(manifest: &RootfsManifest) -> Result<Bool, ContainerError>
  intent "展開された rootfs が ADR 0035 仕様 (単一層、静的 ELF /app、User 65532:65532、実行可能) を満たすかを検査する"
  requires none
  ensures none
  effects none
{
  let mut found_app = false;
  let mut i = 0;
  while i < manifest.entries.len() {
    match manifest.entries.get(i) {
      Some(entry) => {
        if entry.path == "app" || entry.path == "/app" {
          if entry.is_dir {
            return Err(ContainerError.LayerValidation("/app がディレクトリとして配置されています (通常 ELF ファイルである必要があります)。"));
          }
          if entry.size == 0 {
            return Err(ContainerError.LayerValidation("/app のサイズが 0 バイトです。"));
          }
          // 実行権限の確認: mode 0555 (365) または少なくとも user 実行権限 (mode & 0o100 != 0)
          if entry.mode / 64 % 2 == 0 {
            return Err(ContainerError.LayerValidation("/app に実行権限が付与されていません。"));
          }
          // ADR 0035 の UID/GID (65532 または 0)
          if entry.uid != 0 && entry.uid != default_non_root_uid() {
            return Err(ContainerError.LayerValidation("/app の UID が ADR 0035 規定値 (0 または 65532) に一致しません。"));
          }
          if entry.gid != 0 && entry.gid != default_non_root_gid() {
            return Err(ContainerError.LayerValidation("/app の GID が ADR 0035 規定値 (0 または 65532) に一致しません。"));
          }
          // 実際のペイロードを検査し、無効・非静的な実行ファイルを拒否
          match validate_elf_payload(&entry.payload) {
            Ok(_) => {}
            Err(err) => {
              return Err(err);
            }
          }
          found_app = true;
        }
      }
      None => {}
    }
    i = i + 1;
  }

  if !found_app {
    return Err(ContainerError.LayerValidation("ADR 0035 の静的 ELF /app が rootfs に存在しません。"));
  }

  return Ok(true);
}

pub fn manifest_to_rootfs_record(rootfs_id: String, workload_id: String, manifest: &RootfsManifest, status: String) -> RootfsRecord
  intent "RootfsManifest から状態保存用の RootfsRecord を生成する"
  requires none
  ensures none
  effects none
{
  return new_rootfs_record(rootfs_id, workload_id, manifest.destination_path.clone(), manifest.total_bytes, manifest.file_count, status);
}
