module test_runner
  targets server
  trust none

use tests.test_admin_api.run_admin_api_tests;
use tests.test_backup_restore.run_backup_restore_tests;
use tests.test_bundle.run_bundle_tests;
use tests.test_declaration_versioning.run_declaration_versioning_tests;
use tests.test_network.run_network_tests;
use tests.test_reconciler.run_reconciler_tests;
use tests.test_rootfs.run_rootfs_tests;
use tests.test_runtime.run_runtime_tests;
use tests.test_spec.run_spec_tests;
use tests.test_state.run_state_tests;
use tests.test_tar_fuzz.run_tar_fuzz_tests;

pub fn main() -> Int
  intent "すべてのテストを実行し、全合格なら 0、不合格があればエラー番号を返す"
  requires none
  ensures none
  effects none
{
  if !run_spec_tests() {
    return 1;
  }
  if !run_bundle_tests() {
    return 2;
  }
  if !run_tar_fuzz_tests() {
    return 3;
  }
  if !run_state_tests() {
    return 4;
  }
  if !run_rootfs_tests() {
    return 5;
  }
  if !run_runtime_tests() {
    return 6;
  }
  let rc = run_reconciler_tests();
  if rc != 0 {
    return rc;
  }
  if !run_network_tests() {
    return 7;
  }
  if !run_declaration_versioning_tests() {
    return 8;
  }
  if !run_backup_restore_tests() {
    return 9;
  }
  if !run_admin_api_tests() {
    return 10;
  }
  return 0;
}
